#. Settings section title
#: src/index.js
msgid "PDF Header & Footer"
msgstr "Intestazione e piè di pagina PDF"

#. Settings section description
#: src/index.js
msgid "Text printed at the top and bottom of every page when a note is exported to PDF."
msgstr "Testo stampato in alto e in basso su ogni pagina quando una nota viene esportata in PDF."

#. Help text under each header/footer field. Keep {page}, {pages} and {date} as is.
#: src/index.js
msgid "Placeholders: {page}, {pages}, {date}. Leave empty for nothing."
msgstr "Segnaposto: {page}, {pages}, {date}. Lasciare vuoto per non mostrare nulla."

#: src/index.js
msgid "Header - left"
msgstr "Intestazione - sinistra"

#: src/index.js
msgid "Header - centre"
msgstr "Intestazione - centro"

#: src/index.js
msgid "Header - right"
msgstr "Intestazione - destra"

#: src/index.js
msgid "Footer - left"
msgstr "Piè di pagina - sinistra"

#: src/index.js
msgid "Footer - centre"
msgstr "Piè di pagina - centro"

#: src/index.js
msgid "Footer - right"
msgstr "Piè di pagina - destra"

#: src/index.js
msgid "Draw a line under the header and above the footer"
msgstr "Traccia una linea sotto l'intestazione e sopra il piè di pagina"

#: src/index.js
msgid "Font size (pt)"
msgstr "Dimensione carattere (pt)"

#: src/index.js
msgid "Top page margin (mm)"
msgstr "Margine superiore (mm)"

#: src/index.js
msgid "Space reserved for the header."
msgstr "Spazio riservato all'intestazione."

#: src/index.js
msgid "Bottom page margin (mm)"
msgstr "Margine inferiore (mm)"

#: src/index.js
msgid "Space reserved for the footer."
msgstr "Spazio riservato al piè di pagina."
