#. Settings section title
#: src/index.js
msgid "PDF Header & Footer"
msgstr "PDF-Kopf- und Fußzeile"

#. Settings section description
#: src/index.js
msgid "Text printed at the top and bottom of every page when a note is exported to PDF."
msgstr "Text, der beim PDF-Export einer Notiz oben und unten auf jeder Seite gedruckt wird."

#. Help text under each header/footer field. Keep {page}, {pages} and {date} as is.
#: src/index.js
msgid "Placeholders: {page}, {pages}, {date}. Leave empty for nothing."
msgstr "Platzhalter: {page}, {pages}, {date}. Leer lassen, um nichts anzuzeigen."

#: src/index.js
msgid "Header - left"
msgstr "Kopfzeile - links"

#: src/index.js
msgid "Header - centre"
msgstr "Kopfzeile - Mitte"

#: src/index.js
msgid "Header - right"
msgstr "Kopfzeile - rechts"

#: src/index.js
msgid "Footer - left"
msgstr "Fußzeile - links"

#: src/index.js
msgid "Footer - centre"
msgstr "Fußzeile - Mitte"

#: src/index.js
msgid "Footer - right"
msgstr "Fußzeile - rechts"

#: src/index.js
msgid "Draw a line under the header and above the footer"
msgstr "Linie unter der Kopfzeile und über der Fußzeile zeichnen"

#: src/index.js
msgid "Font size (pt)"
msgstr "Schriftgröße (pt)"

#: src/index.js
msgid "Top page margin (mm)"
msgstr "Oberer Seitenrand (mm)"

#: src/index.js
msgid "Space reserved for the header."
msgstr "Platz für die Kopfzeile."

#: src/index.js
msgid "Bottom page margin (mm)"
msgstr "Unterer Seitenrand (mm)"

#: src/index.js
msgid "Space reserved for the footer."
msgstr "Platz für die Fußzeile."
