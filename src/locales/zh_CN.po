#. Settings section title
#: src/index.js
msgid "PDF Header & Footer"
msgstr "PDF 页眉和页脚"

#. Settings section description
#: src/index.js
msgid "Text printed at the top and bottom of every page when a note is exported to PDF."
msgstr "将笔记导出为 PDF 时，打印在每页顶部和底部的文本。"

#. Help text under each header/footer field. Keep {page}, {pages} and {date} as is.
#: src/index.js
msgid "Placeholders: {page}, {pages}, {date}. Leave empty for nothing."
msgstr "占位符：{page}、{pages}、{date}。留空则不显示任何内容。"

#: src/index.js
msgid "Header - left"
msgstr "页眉 - 左"

#: src/index.js
msgid "Header - centre"
msgstr "页眉 - 中"

#: src/index.js
msgid "Header - right"
msgstr "页眉 - 右"

#: src/index.js
msgid "Footer - left"
msgstr "页脚 - 左"

#: src/index.js
msgid "Footer - centre"
msgstr "页脚 - 中"

#: src/index.js
msgid "Footer - right"
msgstr "页脚 - 右"

#: src/index.js
msgid "Draw a line under the header and above the footer"
msgstr "在页眉下方和页脚上方绘制分隔线"

#: src/index.js
msgid "Font size (pt)"
msgstr "字号 (pt)"

#: src/index.js
msgid "Top page margin (mm)"
msgstr "上页边距 (mm)"

#: src/index.js
msgid "Space reserved for the header."
msgstr "为页眉预留的空间。"

#: src/index.js
msgid "Bottom page margin (mm)"
msgstr "下页边距 (mm)"

#: src/index.js
msgid "Space reserved for the footer."
msgstr "为页脚预留的空间。"
