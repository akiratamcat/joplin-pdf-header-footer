#. Settings section title
#: src/index.js
msgid "PDF Header & Footer"
msgstr "PDF 머리글 및 바닥글"

#. Settings section description
#: src/index.js
msgid "Text printed at the top and bottom of every page when a note is exported to PDF."
msgstr "노트를 PDF로 내보낼 때 각 페이지의 위쪽과 아래쪽에 인쇄되는 텍스트입니다."

#. Help text under each header/footer field. Keep {page}, {pages} and {date} as is.
#: src/index.js
msgid "Placeholders: {page}, {pages}, {date}. Leave empty for nothing."
msgstr "자리 표시자: {page}, {pages}, {date}. 비워 두면 아무것도 표시되지 않습니다."

#: src/index.js
msgid "Header - left"
msgstr "머리글 - 왼쪽"

#: src/index.js
msgid "Header - centre"
msgstr "머리글 - 가운데"

#: src/index.js
msgid "Header - right"
msgstr "머리글 - 오른쪽"

#: src/index.js
msgid "Footer - left"
msgstr "바닥글 - 왼쪽"

#: src/index.js
msgid "Footer - centre"
msgstr "바닥글 - 가운데"

#: src/index.js
msgid "Footer - right"
msgstr "바닥글 - 오른쪽"

#: src/index.js
msgid "Draw a line under the header and above the footer"
msgstr "머리글 아래와 바닥글 위에 선 그리기"

#: src/index.js
msgid "Font size (pt)"
msgstr "글꼴 크기 (pt)"

#: src/index.js
msgid "Top page margin (mm)"
msgstr "위쪽 여백 (mm)"

#: src/index.js
msgid "Space reserved for the header."
msgstr "머리글을 위해 확보하는 공간입니다."

#: src/index.js
msgid "Bottom page margin (mm)"
msgstr "아래쪽 여백 (mm)"

#: src/index.js
msgid "Space reserved for the footer."
msgstr "바닥글을 위해 확보하는 공간입니다."
