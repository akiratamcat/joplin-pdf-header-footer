#. Settings section title
#: src/index.js
msgid "PDF Header & Footer"
msgstr "Cabeçalho e rodapé do PDF"

#. Settings section description
#: src/index.js
msgid "Text printed at the top and bottom of every page when a note is exported to PDF."
msgstr "Texto impresso na parte superior e inferior de cada página quando uma nota é exportada para PDF."

#. Help text under each header/footer field. Keep {page}, {pages} and {date} as is.
#: src/index.js
msgid "Placeholders: {page}, {pages}, {date}. Leave empty for nothing."
msgstr "Marcadores: {page}, {pages}, {date}. Deixe em branco para não exibir nada."

#: src/index.js
msgid "Header - left"
msgstr "Cabeçalho - esquerda"

#: src/index.js
msgid "Header - centre"
msgstr "Cabeçalho - centro"

#: src/index.js
msgid "Header - right"
msgstr "Cabeçalho - direita"

#: src/index.js
msgid "Footer - left"
msgstr "Rodapé - esquerda"

#: src/index.js
msgid "Footer - centre"
msgstr "Rodapé - centro"

#: src/index.js
msgid "Footer - right"
msgstr "Rodapé - direita"

#: src/index.js
msgid "Draw a line under the header and above the footer"
msgstr "Desenhar uma linha abaixo do cabeçalho e acima do rodapé"

#: src/index.js
msgid "Font size (pt)"
msgstr "Tamanho da fonte (pt)"

#: src/index.js
msgid "Top page margin (mm)"
msgstr "Margem superior (mm)"

#: src/index.js
msgid "Space reserved for the header."
msgstr "Espaço reservado para o cabeçalho."

#: src/index.js
msgid "Bottom page margin (mm)"
msgstr "Margem inferior (mm)"

#: src/index.js
msgid "Space reserved for the footer."
msgstr "Espaço reservado para o rodapé."
