#. Settings section title
#: src/index.js
msgid "PDF Header & Footer"
msgstr "PDF 頁首和頁尾"

#. Settings section description
#: src/index.js
msgid "Text printed at the top and bottom of every page when a note is exported to PDF."
msgstr "將筆記匯出為 PDF 時，列印在每頁頂端和底端的文字。"

#. Help text under each header/footer field. Keep {page}, {pages} and {date} as is.
#: src/index.js
msgid "Placeholders: {page}, {pages}, {date}. Leave empty for nothing."
msgstr "預留位置：{page}、{pages}、{date}。留空則不顯示任何內容。"

#: src/index.js
msgid "Header - left"
msgstr "頁首 - 左"

#: src/index.js
msgid "Header - centre"
msgstr "頁首 - 中"

#: src/index.js
msgid "Header - right"
msgstr "頁首 - 右"

#: src/index.js
msgid "Footer - left"
msgstr "頁尾 - 左"

#: src/index.js
msgid "Footer - centre"
msgstr "頁尾 - 中"

#: src/index.js
msgid "Footer - right"
msgstr "頁尾 - 右"

#: src/index.js
msgid "Draw a line under the header and above the footer"
msgstr "在頁首下方和頁尾上方繪製分隔線"

#: src/index.js
msgid "Font size (pt)"
msgstr "字型大小 (pt)"

#: src/index.js
msgid "Top page margin (mm)"
msgstr "上邊界 (mm)"

#: src/index.js
msgid "Space reserved for the header."
msgstr "為頁首保留的空間。"

#: src/index.js
msgid "Bottom page margin (mm)"
msgstr "下邊界 (mm)"

#: src/index.js
msgid "Space reserved for the footer."
msgstr "為頁尾保留的空間。"
